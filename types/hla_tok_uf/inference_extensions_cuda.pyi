from collections.abc import Mapping

from torch import Tensor

class DMCIProxy:
    def __init__(self) -> None: ...
    def set_param(self, state_dict: Mapping[str, Tensor], threshold: float) -> None: ...
    def get_decoded_latent(self) -> Tensor: ...
    def uf_encode_snapshot(self) -> list[Tensor]: ...
    def uf_display_snapshot(self) -> list[Tensor]: ...

class DMCLDProxy(DMCIProxy):
    def uf_state_snapshot(self) -> list[Tensor]: ...
