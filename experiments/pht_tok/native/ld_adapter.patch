+
+void DMCLDProxy::reconstruct_y(const at::Tensor& residuals, int qp)
+{
+    const auto [q_dec, scales, means] = chunk_tensors_3(m_common_params);
+    m_y_hat = restore_y_cuda(residuals, means, m_mask_0, m_y_hat);
+    m_means = m_y_spatial_prior.forward(m_cat_spatial_prior);
+    m_y_hat = restore_y_and_add_multiply_inplace_cuda(residuals, m_means, m_mask_1, m_y_hat, q_dec);
+    m_feature_p = m_decoder.forward(m_y_hat, m_cat_decoder, m_q_decoder[qp]);
+}
+
+void DMCLDProxy::prepare_context(bool has_memory)
+{
+    apply_feature_adaptor(has_memory);
+    m_temporal_params = m_temporal_prior_encoder.forward(m_memory);
+    m_ctx = m_feature_extractor.forward(m_memory);
+}
+
+void DMCLDProxy::pht_prepare()
+{
+    run([&](bool has_memory) { prepare_context(has_memory); },
+        m_gexec_pht_context, m_memory_has_value);
+}
+
+void DMCLDProxy::pht_prior(const at::Tensor& z, int qp)
+{
+    m_z_height = m_z_hat_io.size(2);
+    m_z_width = m_z_hat_io.size(3);
+    m_z_hat_io.copy_(z);
+    run([&](int q) { decode_prior(q); }, m_gexec_dec_1, qp);
+}
+
+std::vector<at::Tensor> DMCLDProxy::pht_symbols(bool encoding) const
+{
+    if (encoding) return {m_z_hat_io, m_y_q, m_y_symbol_prev, m_skip_cond};
+    return {m_z_hat_io, m_y_q_r, m_y_indexes_prev, m_skip_cond};
+}
+
+std::vector<at::Tensor> DMCLDProxy::pht_masks() const
+{
+    return {m_mask_0, m_mask_1};
+}
+
+void DMCLDProxy::pht_render(const at::Tensor& residuals, int qp, bool reset)
+{
+    m_y_q_r.copy_(residuals);
+    run([&](int q) { reconstruct_y(m_y_q_r, q); }, m_gexec_pht_synthesis, qp);
+    if (reset) {
+        run([&]() { m_feature_i = m_recon_head.forward_reset(m_feature_p); },
+            m_gexec_pht_refresh);
+    }
+}
+
+at::Tensor DMCLDProxy::pht_display()
+{
+    run([&]() { m_x_hat = m_recon_head.forward(m_feature_p); }, m_gexec_pht_display);
+    return m_x_hat;
+}
+
+
+void DMCLDProxy::pht_load_reference(const std::vector<at::Tensor>& reference, bool refresh)
+{
+    if (refresh) {
+        m_feature_i.copy_(reference.at(0));
+    } else {
+        m_memory.copy_(reference.at(0));
+        m_feature_p.copy_(reference.at(1));
+    }
+    m_memory_has_value = !refresh;
+}
